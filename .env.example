# Public HTTPS production origin; localhost is supported for development.
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mailtrack
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate each independently with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
CRON_SECRET=
# Optional comma-separated addresses allowed to create workspaces. Empty = public signup.
ALLOWED_EMAILS=
