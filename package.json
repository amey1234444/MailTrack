{
  "name": "mailtrack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/pdf-worker.mjs && next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "node scripts/migrate.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "format:check": "prettier --check app components lib tests scripts README.md next.config.ts",
    "vercel-build": "node scripts/vercel-build.mjs"
  },
  "dependencies": {
    "imapflow": "^2.9.1",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.12.4",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
